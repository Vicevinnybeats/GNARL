{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix site ci && npm --prefix site run build && node tools/assemble_deploy.mjs",
  "outputDirectory": "dist",
  "installCommand": "echo 'installed per-package by buildCommand'",
  "framework": null,
  "headers": [
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
