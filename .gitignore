#  Merged from GNARL's own ignore list and Vital's at the fork point.
#
#  ONE RULE WAS DELIBERATELY DROPPED: GNARL ignored `*.xcodeproj/`, which
#  was right when the build was CMake-generated and is WRONG now - Vital
#  ships plugin/builds/osx/GNARL.xcodeproj as source, and that rule would
#  quietly stop git seeing any Xcode project file added from here on.
#  Generated Xcode user state is excluded below instead.

# --- build output -------------------------------------------------------
build
build/
build-*/
cmake-build*/
out/
Debug
Profile
Release
*.o
*.a
*.lib
*.obj
*.tar.gz

# --- built plugin binaries ----------------------------------------------
*.vst
*.VST
*.vst3
*.VST3
*.lv2
*.component
*.app

# --- node / vite (the marketing site) -----------------------------------
node_modules/
.vite/
site/dist/

# --- IDE / OS -----------------------------------------------------------
.vscode/
.idea/
.vs
.clang_complete
.ycm_extra_conf.py*
xcuserdata
xcshareddata
*.xcworkspace
*.pbxuser
*.perspective
*.perspectivev3
*.sdf
*.suo
*.psess
*.vsp
*.tlog
*.user
*.opendb
*.opensdf
*.swp
VTune\ Profiler\ Results
.DS_Store
.DS_Store?
*.Trashes
Thumbs.db

# --- secrets: the licensing private key NEVER enters the repo -----------
*.pem
*.p12
*.key
.env
.env.local

# --- Cloudflare Workers local state (a local D1 lives in here) ----------
.wrangler/
backend/worker-configuration.d.ts

# --- renders and screenshots --------------------------------------------
#  Regenerable, large, and the point of them is to be LOOKED at or
#  MEASURED, not kept. Phase 3 renders land here.
.screenshots/
renders/
*.webm

# --- python bytecode (tools/check_fork.py imports tools/pbxproj.py) ------
__pycache__/
*.pyc
