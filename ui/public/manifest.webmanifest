{
  "name": "GNARL — Wavetable Synthesizer",
  "short_name": "GNARL",
  "description": "A wavetable synthesizer for riddim and dubstep. Triplet growls, formant wobbles, and fourteen effects in any order.",
  "id": "/",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "_orientation_note": "ANY, NOT LANDSCAPE. This was landscape while the plan was to ask the phone to be turned; compact mode replaced that with a layout built for portrait width, and a manifest lock overrides CSS entirely - an installed app obeys it no matter what the stylesheet does. An orientation lock is also a promise about a layout, and this one now works in both.",
  "orientation": "any",
  "background_color": "#05040f",
  "theme_color": "#05040f",
  "categories": ["music", "productivity"],
  "icons": [
    { "src": "icons/icon-96.png",       "sizes": "96x96",   "type": "image/png" },
    { "src": "icons/icon-192.png",      "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png",      "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-192.png",  "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png",  "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
